# All variables are optional: the defaults work under `docker compose up`.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
WEBHOOK_DB_TIMEOUT=1.5
# Webhook rate limit per client IP; 0 disables (needed for big load runs).
WEBHOOK_RATE_PER_MIN=600
WEBHOOK_BURST=200
# Operator UI Basic Auth: change both in production.
OPERATOR_USER=admin
OPERATOR_PASSWORD=admin
# Empty = no-key mode: a real request that fails with 401, then a static draft after 5-30 s.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_RPM=60
LLM_TIMEOUT=60
STUB_DELAY_MIN=5
STUB_DELAY_MAX=30
LLM_CONCURRENCY=20
GEN_MAX_ATTEMPTS=8
LEASE_SECONDS=300
POLL_INTERVAL=1
SHUTDOWN_GRACE=8
SEND_CONCURRENCY=5
SEND_TIMEOUT=10
SEND_LEASE_SECONDS=60
SEND_MAX_ATTEMPTS=10
HELPDESK_ALLOWED_HOSTS=helpdesk.example.com
# Replies go to the mock helpdesk; empty = send to the real reply_url host.
HELPDESK_MOCK_URL=http://mock-helpdesk:8001
# Mock helpdesk service only.
MOCK_FAIL_RATE=0.2
MOCK_SLOW_RATE=0.1
MOCK_SLOW_SECONDS=15
