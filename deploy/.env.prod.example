# Production .env for the server (repo root, mode 600). deploy/README.md, "First deploy", fills it.
# Every other setting keeps its compose.yaml default (see README.md, Configuration).

# Required (compose refuses to start without them; deploy.sh also rejects change-me).
# 32+ hex characters, generated on the server: openssl rand -hex 32. Used once, when the volume is created.
POSTGRES_PASSWORD=change-me
# Operator UI Basic Auth; the mock helpdesk page uses the same pair (in the shared Caddy). 16+ characters.
OPERATOR_USER=admin
OPERATOR_PASSWORD=change-me
# The public address. Baked into the KB links of every stored draft.
# Now: http://<server-ip>:8030. With a domain: https://your-domain.tld
PUBLIC_BASE_URL=http://change-me:8030

# Optional. Empty = no-key mode: static drafts after 5-30 s, everything else as with the real path.
# Put a key here and run deploy/deploy.sh again to switch to real Claude drafts.
ANTHROPIC_API_KEY=

# Replies go to the mock helpdesk (its page: :8031 / helpdesk.your-domain.tld). Keep both as they are.
HELPDESK_MOCK_URL=http://mock-helpdesk:8001
HELPDESK_ALLOWED_HOSTS=helpdesk.example.com
